# Labor-Patient: Container, in dem der kx-Agent läuft ("infizierter" Host).
# Der Agent extrahiert NUR die Secrets dieses Containers und installiert
# Persistenz NUR in diesem Container. Niemals auf dem Host ausführen.
# Basis ubuntu:24.04: das Host-Binary braucht glibc >= 2.39 (bookworm: 2.36).
FROM ubuntu:24.04
RUN apt-get update \
    && apt-get install -y --no-install-recommends sshpass openssh-client \
    && rm -rf /var/lib/apt/lists/*
# Demo-Beute, nur in diesem Container: ein echtes Wegwerf-Schlüsselpaar,
# eine Beispiel-AWS-Datei (RFC-Beispielwerte) und ein Root-Passwort,
# damit /etc/shadow einen echten Hash enthält.
RUN mkdir -p /root/.ssh /root/.aws \
    && ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N '' -C 'kx-lab-demo-wegwerf' -q \
    && printf '%s\n' '[default]' 'aws_access_key_id = AKIAIOSFODNN7EXAMPLE' 'aws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY' 'region = eu-central-1' > /root/.aws/credentials \
    && echo 'root:patient0-lab-only' | chpasswd
COPY patient0-entrypoint.sh /usr/local/bin/patient0-entrypoint.sh
RUN chmod +x /usr/local/bin/patient0-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/patient0-entrypoint.sh"]